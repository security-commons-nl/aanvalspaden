{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "paden.json",
  "description": "De gedeelde bron voor de aanvalspaden: vijf clusters voor het overzicht, achttien bladeren voor het detail. Zelfcheck, risicoanalyse en meting lezen dit bestand.",
  "type": "object",
  "required": [
    "versie",
    "toelichting",
    "clusters",
    "onderdelen",
    "bladeren",
    "randvoorwaarden",
    "regels"
  ],
  "additionalProperties": false,
  "properties": {
    "versie": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "toelichting": {
      "type": "string",
      "minLength": 20
    },
    "clusters": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "titel",
          "kern",
          "bladeren"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[1-5]$"
          },
          "titel": {
            "type": "string",
            "minLength": 5
          },
          "kern": {
            "type": "string",
            "minLength": 20
          },
          "bladeren": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^AP[0-9]{2}$"
            }
          }
        }
      }
    },
    "bladeren": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "required": [
          "id",
          "titel",
          "type",
          "scenario",
          "chokepoints",
          "bronnen",
          "regels"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AP[0-9]{2}$"
          },
          "titel": {
            "type": "string",
            "pattern": "→"
          },
          "type": {
            "enum": [
              "pad",
              "impact"
            ],
            "description": "pad: een route die een aanvaller loopt. impact: een samengesteld gevolg (ransomware), geen kolom in de matrix."
          },
          "scenario": {
            "type": "string",
            "minLength": 20
          },
          "nuance": {
            "type": "string",
            "minLength": 20,
            "description": "Wat een positieve uitkomst nog niet betekent; de restrisico's bij dit pad."
          },
          "chokepoints": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "id",
                "vraag_id",
                "onderdeel",
                "titel",
                "vraag",
                "drp",
                "bewijs"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^AP[0-9]{2}-[0-9]+$"
                },
                "titel": {
                  "type": "string",
                  "minLength": 5
                },
                "vraag": {
                  "type": "object",
                  "required": [
                    "claim",
                    "toelichting",
                    "actie"
                  ],
                  "additionalProperties": false,
                  "description": "De vraagmethodiek: wat claim je, wat betekent dat, wat telt niet mee, en wat is de maatregel.",
                  "properties": {
                    "claim": {
                      "type": "string",
                      "pattern": "\\?$"
                    },
                    "toelichting": {
                      "type": "string",
                      "minLength": 10
                    },
                    "telt_niet": {
                      "type": "string",
                      "minLength": 10
                    },
                    "verificatie": {
                      "type": "string",
                      "minLength": 10
                    },
                    "actie": {
                      "type": "string",
                      "minLength": 10
                    }
                  }
                },
                "drp": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "D",
                      "R",
                      "P"
                    ]
                  },
                  "description": "D detecteren, R reageren, P preventief tegenhouden."
                },
                "bewijs": {
                  "type": "string",
                  "minLength": 10,
                  "description": "Welk artefact deze cel groen maakt in diepte 1. Zonder dit blijft de cel rood."
                },
                "vraag_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$",
                  "description": "Stabiele sleutel van de vraag. Dezelfde vraag bij meer paden deelt deze sleutel en wordt maar een keer gesteld."
                },
                "negatief": {
                  "const": true,
                  "description": "Ja betekent hier dat de barriere ontbreekt; draai ja en nee om voor de regels."
                },
                "opties": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "label",
                      "uitleg"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z]+$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 2
                      },
                      "uitleg": {
                        "type": "string",
                        "minLength": 5
                      }
                    }
                  },
                  "description": "Eigen antwoordopties in plaats van de standaardlijst uit regels.antwoorden."
                },
                "alleen_als": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$",
                  "description": "Stel deze vraag alleen als de genoemde vraag niet met nee is beantwoord."
                },
                "onderdeel": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6,
                  "description": "Het onderdeel waarin de zelfcheck deze vraag stelt; zie onderdelen."
                }
              }
            }
          },
          "bronnen": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "regels": {
            "type": "object",
            "required": [
              "vereist",
              "beperkt",
              "reactief"
            ],
            "additionalProperties": false,
            "description": "De regelsets waarmee de zelfcheck de status van dit pad bepaalt; zie regels.bepaling.",
            "properties": {
              "vereist": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$",
                  "description": "Stabiele sleutel van de vraag. Dezelfde vraag bij meer paden deelt deze sleutel en wordt maar een keer gesteld."
                }
              },
              "beperkt": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$",
                  "description": "Stabiele sleutel van de vraag. Dezelfde vraag bij meer paden deelt deze sleutel en wordt maar een keer gesteld."
                }
              },
              "reactief": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$",
                  "description": "Stabiele sleutel van de vraag. Dezelfde vraag bij meer paden deelt deze sleutel en wordt maar een keer gesteld."
                }
              },
              "plafond": {
                "enum": [
                  "limited"
                ],
                "description": "Hoger dan deze status komt het pad niet, ook niet als alles ja is."
              }
            }
          }
        }
      }
    },
    "randvoorwaarden": {
      "type": "array",
      "minItems": 1,
      "description": "Vragen die voor de hele beoordeling gelden in plaats van voor een enkel pad.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "vraag_id",
          "onderdeel",
          "titel",
          "vraag",
          "werking"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "titel": {
            "type": "string",
            "minLength": 5
          },
          "vraag": {
            "type": "object",
            "required": [
              "claim",
              "toelichting",
              "actie"
            ],
            "additionalProperties": false,
            "description": "De vraagmethodiek: wat claim je, wat betekent dat, wat telt niet mee, en wat is de maatregel.",
            "properties": {
              "claim": {
                "type": "string",
                "pattern": "\\?$"
              },
              "toelichting": {
                "type": "string",
                "minLength": 10
              },
              "telt_niet": {
                "type": "string",
                "minLength": 10
              },
              "verificatie": {
                "type": "string",
                "minLength": 10
              },
              "actie": {
                "type": "string",
                "minLength": 10
              }
            }
          },
          "werking": {
            "type": "string",
            "minLength": 20
          },
          "vraag_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "Stabiele sleutel van de vraag. Dezelfde vraag bij meer paden deelt deze sleutel en wordt maar een keer gesteld."
          },
          "onderdeel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6,
            "description": "Het onderdeel waarin de zelfcheck deze vraag stelt; zie onderdelen."
          }
        }
      }
    },
    "regels": {
      "type": "object",
      "required": [
        "toelichting",
        "antwoorden",
        "telt_als_ja",
        "negatief",
        "statussen",
        "bepaling",
        "randvoorwaarde",
        "uitzonderingen",
        "acties"
      ],
      "additionalProperties": false,
      "description": "De scoreregels als data. Een app leest ze hier en heeft geen eigen versie.",
      "properties": {
        "toelichting": {
          "type": "string",
          "minLength": 20
        },
        "antwoorden": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "uitleg"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z]+$"
              },
              "label": {
                "type": "string",
                "minLength": 2
              },
              "uitleg": {
                "type": "string",
                "minLength": 5
              }
            }
          }
        },
        "telt_als_ja": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "negatief": {
          "type": "string",
          "minLength": 20
        },
        "statussen": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "uitleg"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z]+$"
              },
              "label": {
                "type": "string",
                "minLength": 2
              },
              "uitleg": {
                "type": "string",
                "minLength": 5
              }
            }
          },
          "description": "Van slechtst naar best; die volgorde bepaalt de samenstelling van AP17."
        },
        "bepaling": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "randvoorwaarde": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Stabiele sleutel van de vraag. Dezelfde vraag bij meer paden deelt deze sleutel en wordt maar een keer gesteld."
        },
        "uitzonderingen": {
          "type": "object",
          "required": [
            "AP05",
            "AP17"
          ],
          "additionalProperties": false,
          "properties": {
            "AP05": {
              "type": "object",
              "required": [
                "toelichting",
                "model_telt_als_ja",
                "bepaling"
              ],
              "additionalProperties": false,
              "properties": {
                "toelichting": {
                  "type": "string",
                  "minLength": 20
                },
                "model_telt_als_ja": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "bepaling": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 10
                  }
                }
              }
            },
            "AP17": {
              "type": "object",
              "required": [
                "toelichting",
                "toegangspaden",
                "herstelbaarheid"
              ],
              "additionalProperties": false,
              "properties": {
                "toelichting": {
                  "type": "string",
                  "minLength": 20
                },
                "toegangspaden": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^AP[0-9]{2}$"
                  }
                },
                "herstelbaarheid": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 10
                  }
                }
              }
            }
          }
        },
        "acties": {
          "type": "object",
          "required": [
            "toelichting",
            "gewicht",
            "factor_preventief",
            "aantal"
          ],
          "additionalProperties": false,
          "properties": {
            "toelichting": {
              "type": "string",
              "minLength": 20
            },
            "gewicht": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "factor_preventief": {
              "type": "number"
            },
            "aantal": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "onderdelen": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "description": "De zeven onderdelen waarin de vragen worden gesteld, met per onderdeel de vraagvolgorde.",
      "items": {
        "type": "object",
        "required": [
          "nummer",
          "titel",
          "vragen"
        ],
        "additionalProperties": false,
        "properties": {
          "nummer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "titel": {
            "type": "string",
            "minLength": 5
          },
          "vragen": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          }
        }
      }
    }
  }
}
